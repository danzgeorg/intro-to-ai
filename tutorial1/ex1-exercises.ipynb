    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"iris.csv\")\n",
    "print(df.columns)\n",
    "print(df)\n",
    "\n",
    "print(df[df[\"petal_w\"] < 1.0])\n",
    "df_sorted = df.sort_values(by=\"sepal_l\")\n",
    "print(df_sorted)\n",
    "df_sorted.to_csv(\"iris-sorted.csv\", index=False)\n",
    "print(df[\"sepal_l\"].var())\n"
